{
  "name": "vendor/contao-issue-service-bundle",
  "description": "Issue and service management for Contao 5.7 and Contao 6",
  "type": "contao-bundle",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "contao/core-bundle": "^5.7 || ^6.0",
    "contao/manager-plugin": "^2.0",
    "doctrine/dbal": "^3.8 || ^4.0",
    "symfony/clock": "^6.4 || ^7.0",
    "symfony/form": "^6.4 || ^7.0",
    "symfony/mailer": "^6.4 || ^7.0",
    "symfony/mime": "^6.4 || ^7.0",
    "symfony/security-bundle": "^6.4 || ^7.0",
    "symfony/uid": "^6.4 || ^7.0",
    "symfony/validator": "^6.4 || ^7.0"
  },
  "require-dev": {
    "contao/test-case": "^5.0",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.12 || ^2.0"
  },
  "autoload": {"psr-4": {"Vendor\\ContaoIssueServiceBundle\\": "src/"}},
  "autoload-dev": {"psr-4": {"Vendor\\ContaoIssueServiceBundle\\Tests\\": "tests/"}},
  "extra": {"contao-manager-plugin": "Vendor\\ContaoIssueServiceBundle\\ContaoManager\\Plugin"},
  "config": {"sort-packages": true, "allow-plugins": {"contao-components/installer": true, "contao/manager-plugin": true}}
}
