{% extends "@Contao/fe_page" %}{% block main %}<main id="main" class="issue-service"><h1>{{ issue.ticket_number }} - {{ issue.title }}</h1><dl><dt>Service</dt><dd>{{ issue.service_title }}</dd><dt>Status</dt><dd>{{ issue.status_title }}</dd><dt>Beschreibung</dt><dd>{{ issue.description|nl2br }}</dd></dl><h2>Verlauf</h2>{% for e in timeline %}<article><time>{{ e.created_at }}</time><p>{{ e.text }}</p></article>{% endfor %}<h2>Antworten</h2>{{ form_start(commentForm,{action:path('issue_service_comment',{uuid:issue.uuid|default('')})}) }}{{ form_widget(commentForm) }}{{ form_end(commentForm) }}</main>{% endblock %}
