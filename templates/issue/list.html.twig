<main id="main" class="issue-service">
    <h1>Meine Issues</h1>

    <p><a href="{{ path('issue_service_create') }}">Neues Issue</a></p>

    <table>
        <thead>
            <tr>
                <th>Ticket</th>
                <th>Titel</th>
                <th>Service</th>
                <th>Status</th>
                <th>Aktualisiert</th>
            </tr>
        </thead>
        <tbody>
            {% for i in issues %}
                <tr>
                    <td><a href="{{ path('issue_service_detail', {uuid: i.uuid|default('')}) }}">{{ i.ticket_number }}</a></td>
                    <td>{{ i.title }}</td>
                    <td>{{ i.service_title }}</td>
                    <td>{{ i.status_title }}</td>
                    <td>{{ i.updated_at }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">Keine Issues vorhanden.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</main>
