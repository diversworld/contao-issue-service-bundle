{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    <div class="issue-service issue-service-list">
        {% if loginRequired %}
            <p class="issue-service__empty">{{ loginRequiredMessage }}</p>
        {% elseif issues is empty %}
            <p class="issue-service__empty">{{ emptyMessage }}</p>
        {% else %}
            <div class="issue-service__table-wrap">
            <table class="issue-service__table">
                <thead>
                    <tr>
                        <th>Ticket</th>
                        <th>Titel</th>
                        <th>Service</th>
                        <th>Status</th>
                        <th>Aktualisiert</th>
                    </tr>
                </thead>
                <tbody>
                    {% for issue in issues %}
                        <tr>
                            <td><a class="issue-service__ticket-link" href="{{ issue.detail_url }}">{{ issue.ticket_number }}</a></td>
                            <td class="issue-service__title">{{ issue.title }}</td>
                            <td>{{ issue.service_title }}</td>
                            <td><span class="issue-service__badge">{{ issue.status_title }}</span></td>
                            <td>{{ issue.last_public_activity_at }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
