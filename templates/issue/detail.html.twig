<main id="main" class="issue-service">
    <h1>{{ issue.ticket_number }} - {{ issue.title }}</h1>

    <dl>
        <dt>Service</dt>
        <dd>{{ issue.service_title }}</dd>
        <dt>Status</dt>
        <dd>{{ issue.status_title }}</dd>
        <dt>Beschreibung</dt>
        <dd>{{ issue.description|nl2br }}</dd>
    </dl>

<section class="issue-service__section">
    <h4>Anhänge</h4>
    <ul>
        {% for attachment in attachments|default([]) %}
            <li><a href="{{ path('issue_service_attachment', {uuid: issue.uuid, id: attachment.id}) }}">{{ attachment.original_name }}</a> ({{ (attachment.file_size / 1024)|round(1) }} KB)</li>
        {% else %}
            <li>Keine Anhänge vorhanden.</li>
        {% endfor %}
    </ul>
</section>

    <h2>Verlauf</h2>
    {% for e in timeline %}
        <article>
            <time>{{ e.created_at }}</time>
                            {% if e.entry_type == 'comment' %}<span>{{ e.author_type == 'user' ? 'Bearbeiter' : 'Nutzer' }}</span>{% endif %}
            <p>{{ e.text|nl2br }}</p>
        </article>
    {% endfor %}

    <h2>Antworten</h2>
    {{ form_start(commentForm, {action: path('issue_service_comment', {uuid: issue.uuid|default('')})}) }}
        {{ form_widget(commentForm) }}
    {{ form_end(commentForm) }}
</main>
