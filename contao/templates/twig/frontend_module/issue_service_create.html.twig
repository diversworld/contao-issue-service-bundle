{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    <div class="issue-service issue-service-create">
        {% if loginRequired %}
            <p class="issue-service__empty">{{ loginRequiredMessage }}</p>
        {% else %}
            {{ form_start(form, {action: action, attr: {class: 'issue-service__form'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.serviceId) }}
                {{ form_row(form.categoryId) }}
                {{ form_row(form.type) }}
                {{ form_row(form.priority) }}
                <p class="issue-service__status">Status: Neu</p>
                {{ form_row(form.title) }}
                {{ form_row(form.description) }}
                {{ form_row(form.attachments) }}
                {{ form_row(form.submit) }}
            {{ form_end(form) }}
        {% endif %}
    </div>
{% endblock %}
