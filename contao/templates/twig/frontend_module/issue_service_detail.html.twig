{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    <div class="issue-service issue-service-detail">
        {% if issue is empty %}
            <p class="issue-service__empty">{{ emptyMessage }}</p>
        {% else %}
            <header class="issue-service__header">
                <p class="issue-service__kicker">{{ issue.ticket_number }}</p>
                <h3>{{ issue.title }}</h3>
                <div class="issue-service__meta">
                    <span class="issue-service__badge">{{ issue.status_title }}</span>
                    <span>{{ issue.service_title }}</span>
                </div>
            </header>

            <dl class="issue-service__definition-list">
                <dt>Service</dt>
                <dd>{{ issue.service_title }}</dd>
                <dt>Status</dt>
                <dd>{{ issue.status_title }}</dd>
                <dt>Beschreibung</dt>
                <dd>{{ issue.description|nl2br }}</dd>
            </dl>

            <section class="issue-service__section">
                <h4>Verlauf</h4>
                <div class="issue-service__timeline">
                    {% for entry in timeline %}
                        <article class="issue-service__timeline-entry">
                            <time>{{ entry.created_at }}</time>
                            {% if entry.entry_type == 'comment' %}<span>{{ entry.author_type == 'user' ? 'Bearbeiter' : 'Nutzer' }}</span>{% endif %}
                            <p>{{ entry.text|nl2br }}</p>
                        </article>
                    {% else %}
                        <p class="issue-service__empty">Noch keine Verlaufseintraege vorhanden.</p>
                    {% endfor %}
                </div>
            </section>

            <section class="issue-service__section issue-service__reply">
                <h4>Antworten</h4>
                {{ form_start(commentForm, {action: path('issue_service_comment', {uuid: issue.uuid|default('')}), attr: {class: 'issue-service__form'}}) }}
                    {{ form_widget(commentForm) }}
                {{ form_end(commentForm) }}
            </section>
        {% endif %}
    </div>
{% endblock %}
